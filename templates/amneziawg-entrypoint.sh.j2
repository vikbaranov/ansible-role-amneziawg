#!/bin/bash
# AmneziaWG Docker entrypoint
# Generated by Ansible amneziawg role

set -e

INTERFACE="${1:-{{ amneziawg_interface }}}"
CONFIG_FILE="{{ amneziawg_remote_directory }}/$INTERFACE.conf"

# Determine VPN subnet from config
SUBNET="{{ amneziawg_addresses[0] }}"

# Default outbound interface (auto-detected on host since we use --network host)
DEFAULT_IFACE=$(ip -4 route show default 2>/dev/null | head -1 | awk '{print $5}')

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

setup_iptables() {
    log "Setting up iptables for $INTERFACE..."
    log "Subnet: $SUBNET"
    log "Default interface: ${DEFAULT_IFACE:-none detected}"

    # Allow all traffic on the VPN interface
    iptables -A INPUT -i "$INTERFACE" -j ACCEPT
    iptables -A FORWARD -i "$INTERFACE" -j ACCEPT
    iptables -A OUTPUT -o "$INTERFACE" -j ACCEPT

    # Allow forwarding from VPN subnet to default outbound interface(s)
    for IFACE in "$DEFAULT_IFACE" "eth0" "eth1"; do
        if [ -n "$IFACE" ]; then
            log "Adding FORWARD rule for interface: $IFACE"
            iptables -A FORWARD -i "$INTERFACE" -o "$IFACE" -s "$SUBNET" -j ACCEPT || log "Warning: failed to add FORWARD rule for $IFACE"
        fi
    done

    # Allow established/related connections back
    iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

    # NAT/masquerade VPN traffic to the Internet
    for IFACE in "$DEFAULT_IFACE" "eth0" "eth1"; do
        if [ -n "$IFACE" ]; then
            log "Adding MASQUERADE rule for interface: $IFACE"
            iptables -t nat -A POSTROUTING -s "$SUBNET" -o "$IFACE" -j MASQUERADE || log "Warning: failed to add MASQUERADE rule for $IFACE"
        fi
    done

    log "iptables setup complete"
}

cleanup_iptables() {
    log "Cleaning up iptables for $INTERFACE..."

    for IFACE in "$DEFAULT_IFACE" "eth0" "eth1"; do
        if [ -n "$IFACE" ]; then
            iptables -t nat -D POSTROUTING -s "$SUBNET" -o "$IFACE" -j MASQUERADE 2>/dev/null || true
            iptables -D FORWARD -i "$INTERFACE" -o "$IFACE" -s "$SUBNET" -j ACCEPT 2>/dev/null || true
        fi
    done

    iptables -D FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true
    iptables -D OUTPUT -o "$INTERFACE" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -i "$INTERFACE" -j ACCEPT 2>/dev/null || true
    iptables -D INPUT -i "$INTERFACE" -j ACCEPT 2>/dev/null || true
}

cleanup() {
    log "Shutting down $INTERFACE..."
    cleanup_iptables
    awg-quick down "$INTERFACE" || true
    exit 0
}

trap cleanup TERM INT

log "Starting AmneziaWG container..."
log "Interface: $INTERFACE"
log "Config: $CONFIG_FILE"
log "VPN subnet: $SUBNET"

# Verify IP forwarding is enabled
IP_FORWARD=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo "0")
log "IP forwarding status: $IP_FORWARD"
if [ "$IP_FORWARD" != "1" ]; then
    log "WARNING: net.ipv4.ip_forward is not enabled. VPN clients will not have Internet access."
fi

# Remove stale interface from previous container run (--network host leaves it on host)
if ip link show "$INTERFACE" >/dev/null 2>&1; then
    log "Interface $INTERFACE already exists, removing stale interface..."
    awg-quick down "$INTERFACE" 2>/dev/null || true
    ip link delete "$INTERFACE" 2>/dev/null || true
    sleep 1
fi

# Bring up the interface
log "Bringing up $INTERFACE..."
awg-quick up "$INTERFACE"

# Verify interface is up
if ip link show "$INTERFACE" >/dev/null 2>&1; then
    log "Interface $INTERFACE is up"
    log "Interface addresses:"
    ip addr show "$INTERFACE" 2>/dev/null || true
else
    log "ERROR: Interface $INTERFACE failed to come up"
    exit 1
fi

# Set up NAT and forwarding
setup_iptables

log "AmneziaWG is ready. Keeping container alive..."

# Keep container running
while true; do
    sleep 60
    if ! ip link show "$INTERFACE" >/dev/null 2>&1; then
        log "ERROR: Interface $INTERFACE is down. Exiting."
        exit 1
    fi
done
